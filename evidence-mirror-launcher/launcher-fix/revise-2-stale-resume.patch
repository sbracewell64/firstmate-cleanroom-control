+permission_policy_owner() {  # <harness>
+  case "${1:-}" in
+    claude) echo 'this launcher (primary console argv) + fm-spawn (workers)' ;;
+    codex|opencode|grok|kimi|cursor|muse) echo 'fm-spawn (workers and secondmates)' ;;
+    *) echo none ;;
+  esac
